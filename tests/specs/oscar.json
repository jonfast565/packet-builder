{
  "spec": "../../examples/oscar.packet",
  "cases": [
    {
      "name": "FLAP sign-on frame from the server",
      "packet": "Flap",
      "hex": "2a011f3a000400000001",
      "expect": {
        "start": 42,
        "channel": 1,
        "sequence": 7994,
        "length": 4,
        "payload": {
          "kind": "signon",
          "value": {
            "version": 1,
            "tlvs": []
          }
        }
      }
    },
    {
      "name": "FLAP sign-on payload with an auth cookie",
      "packet": "FlapSignon",
      "hex": "00000001000600088e2f5bc4d1a07733",
      "expect": {
        "version": 1,
        "tlvs": [
          {
            "type": 6,
            "length": 8,
            "value": "8e2f5bc4d1a07733"
          }
        ]
      }
    },
    {
      "name": "FLAP keep-alive",
      "packet": "Flap",
      "hex": "2a0500070000",
      "expect": {
        "start": 42,
        "channel": 5,
        "sequence": 7,
        "length": 0,
        "payload": {
          "kind": "other",
          "value": ""
        }
      }
    },
    {
      "name": "FLAP with a bad start byte is rejected",
      "packet": "Flap",
      "hex": "210200000000",
      "error_kind": "constraint",
      "error_path": "Flap.start"
    },
    {
      "name": "FLAP truncated payload",
      "packet": "Flap",
      "hex": "2a02000100040017",
      "error": true
    },
    {
      "name": "FLAP length is computed from the payload on encode",
      "packet": "Flap",
      "hex": "2a05000100020017",
      "set": {
        "length": 3
      },
      "encoded": "2a05000100020017"
    },
