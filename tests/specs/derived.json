      "error_kind": "mismatch",
      "error_path": "CkCrc16Xmodem.sum"
    },
    {
      "name": "crc16_kermit check value",
      "packet": "CkCrc16Kermit",
      "hex": "313233343536373839 2189",
      "expect": {
        "sum": 8585
      }
    },
    {
      "name": "crc16_kermit wrong value",
      "packet": "CkCrc16Kermit",
      "hex": "313233343536373839 0000",
      "error_kind": "mismatch",
      "error_path": "CkCrc16Kermit.sum"
    },
    {
      "name": "crc16_modbus check value",
      "packet": "CkCrc16Modbus",
      "hex": "313233343536373839 4b37",
      "expect": {
        "sum": 19255
      }
    },
    {
      "name": "crc16_modbus wrong value",
      "packet": "CkCrc16Modbus",
      "hex": "313233343536373839 0000",
      "error_kind": "mismatch",
      "error_path": "CkCrc16Modbus.sum"
    },
    {
      "name": "crc32 check value",
      "packet": "CkCrc32",
      "hex": "313233343536373839 cbf43926",
      "expect": {
        "sum": 3421780262
      }
    },
    {
      "name": "crc32 wrong value",
      "packet": "CkCrc32",
      "hex": "313233343536373839 00000000",
      "error_kind": "mismatch",
      "error_path": "CkCrc32.sum"
    },
    {
      "name": "crc32c check value",
      "packet": "CkCrc32c",
      "hex": "313233343536373839 e3069283",
      "expect": {
        "sum": 3808858755
      }
    },
    {
      "name": "crc32c wrong value",
      "packet": "CkCrc32c",
      "hex": "313233343536373839 00000000",
      "error_kind": "mismatch",
      "error_path": "CkCrc32c.sum"
    },
    {
      "name": "internet check value",
      "packet": "CkInternet",
      "hex": "313233343536373839 f62a",
      "expect": {
        "sum": 63018
      }
    },
    {
      "name": "internet wrong value",
      "packet": "CkInternet",
      "hex": "313233343536373839 0000",
