{
  "spec": "access.packet",
  "access": true,
  "cases": [
    {
      "name": "whole packet",
      "packet": "Header",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "expect": {
        "ihl": 5,
        "code": 5,
        "n": 2,
        "name": "hi",
        "tail": 3735928559
      }
    },
    {
      "name": "view version",
      "packet": "Header_version",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "40",
      "expect": {
        "version": 4
      }
    },
    {
      "name": "view ihl",
      "packet": "Header_ihl",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "05",
      "expect": {
        "ihl": 5
      }
    },
    {
      "name": "view urgent",
      "packet": "Header_urgent",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "0080",
      "expect": {
        "urgent": 1
      }
    },
    {
      "name": "view code",
      "packet": "Header_code",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "0005",
      "expect": {
        "code": 5
      }
    },
    {
      "name": "view n",
      "packet": "Header_n",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "000002",
      "expect": {
        "n": 2
      }
    },
    {
      "name": "view items",
      "packet": "Header_items",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "00000200010002",
      "expect": {
        "items": [
          1,
          2
        ]
      }
    },
    {
      "name": "view pair",
      "packet": "Header_pair",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "000002000000000a0b",
      "expect": {
        "pair": {
          "a": 10,
          "b": 11
        }
      }
    },
    {
      "name": "view kind",
      "packet": "Header_kind",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "00000200000000000001",
      "expect": {
        "kind": 1
      }
    },
    {
      "name": "view length",
      "packet": "Header_length",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "0000020000000000000004",
      "expect": {
        "length": 4
      }
    },
    {
      "name": "view body",
      "packet": "Header_body",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "000002000000000000010400000007"
    },
    {
      "name": "view name",
      "packet": "Header_name",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "000002000000000000000400000000686900",
      "expect": {
        "name": "hi"
      }
    },
    {
      "name": "view ptr",
      "packet": "Header_ptr",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "00000200000000000000040000000068690017",
      "expect": {
        "ptr": 23
      }
    },
    {
      "name": "view target",
      "packet": "Header_target",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "00000200000000000000040000000068690017000000001234",
      "expect": {
        "target": {
          "v": 4660
        }
      }
    },
    {
      "name": "view tail",
      "packet": "Header_tail",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "encoded": "00000200000000000000040000000068690000deadbeef",
      "expect": {
        "tail": 3735928559
      }
    },
    {
      "name": "view of a field after a different-size window",
      "packet": "Header_tail",
      "hex": "45 85 00 0a0b 02 02 0c0d 00 05 cafef00d 0000",
      "expect": {
        "n": 0,
        "length": 2,
        "name": "",
        "tail": 3405705229
      },
      "encoded": "0000000000000200000000cafef00d"
    },
    {
      "name": "view of a truncated packet",
      "packet": "Header_tail",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 dead",
      "error_kind": "incomplete"
    },
    {
      "name": "whole list",
      "packet": "List",
      "hex": "03 01aa 00 02bbcc 02 0102 0304 0005 0006 0007",
      "expect": {
        "m": 3,
        "q": 2
      }
    },
    {
      "name": "element of a fixed-size array",
      "packet": "Header_items_at",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "args": [
        1
      ],
      "expect": {
        "items": 2
      },
      "encoded": "00000200000002"
    },
    {
      "name": "element past the end",
      "packet": "Header_items_at",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "args": [
        2
      ],
      "error_kind": "constraint"
    },
    {
      "name": "element of variable size",
      "packet": "List_vars_at",
      "hex": "03 01aa 00 02bbcc 02 0102 0304 0005 0006 0007",
      "args": [
        2
      ],
      "expect": {
        "vars": {
          "k": 2,
          "d": "bbcc"
        }
      },
      "encoded": "0301aa0002bbcc"
    },
    {
      "name": "first element of variable size",
      "packet": "List_vars_at",
      "hex": "03 01aa 00 02bbcc 02 0102 0304 0005 0006 0007",
      "args": [
        0
      ],
      "expect": {
        "vars": {
          "k": 1,
          "d": "aa"
        }
      },
      "encoded": "0301aa"
    },
    {
      "name": "element packet after a variable array",
      "packet": "List_pairs_at",
      "hex": "03 01aa 00 02bbcc 02 0102 0304 0005 0006 0007",
      "args": [
        1
      ],
      "expect": {
        "pairs": {
          "a": 3,
          "b": 4
        }
      },
      "encoded": "0301aa0002bbcc0200000304"
    },
    {
      "name": "element of a remaining array",
      "packet": "List_rest_at",
      "hex": "03 01aa 00 02bbcc 02 0102 0304 0005 0006 0007",
      "args": [
        2
      ],
      "expect": {
        "rest": 7
      },
      "encoded": "0301aa0002bbcc0200000000000000000007"
    },
    {
      "name": "element of a remaining array past the end",
      "packet": "List_rest_at",
      "hex": "03 01aa 00 02bbcc 02 0102 0304 0005 0006 0007",
      "args": [
        3
      ],
      "error_kind": "incomplete"
    },
    {
      "name": "setter after variable data",
      "packet": "Header_tail_set",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "set": {
        "tail": 1
      },
      "encoded": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 00000001 1234"
    },
    {
      "name": "setter keeps reserved bits",
      "packet": "Header_code_set",
      "hex": "45 f5 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "set": {
        "code": 3
      },
      "encoded": "45 f3 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234"
    },
    {
      "name": "setter of a nibble",
      "packet": "Header_ihl_set",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "set": {
        "ihl": 6
      },
      "encoded": "46 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234"
    },
    {
      "name": "setter out of range",
      "packet": "Header_ihl_set",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "set": {
        "ihl": 16
      },
      "encode_error": true,
      "encode_error_kind": "range"
    },
    {
      "name": "setter keeps the member's check",
      "packet": "Header_version_set",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234",
      "set": {
        "version": 5
      },
      "encode_error": true,
      "encode_error_kind": "constraint"
    },
    {
      "name": "setter unchanged",
      "packet": "Header_pair_set",
      "hex": "45 85 02 0001 0002 0a0b 01 04 00000007 686900 17 deadbeef 1234"
    },
    {
      "name": "setter recomputes the checksum",
      "packet": "Summed_ttl_set",
      "hex": "4011adba1234ffee",
      "set": {
        "ttl": 1
      },
      "encoded": "0111ecba1234ffee"
    }
  ]
}
