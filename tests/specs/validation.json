{
  "spec": "validation.packet",
  "cases": [
    { "name": "valid", "packet": "Checked", "hex": "beef 05 13 02 40 02 aabb",
      "expect": { "magic": 48879, "ttl": 5, "kind": 1, "level": 3, "version": 2, "mode": 2, "rest": 0,
                  "len": 2, "data": "aabb" } },
    { "name": "wrong magic", "packet": "Checked", "hex": "beee 05 13 02 40 02 aabb",
      "error_kind": "constraint", "error_path": "Checked.magic" },
    { "name": "ttl below range", "packet": "Checked", "hex": "beef 00 13 02 40 02 aabb",
      "error_kind": "constraint", "error_path": "Checked.ttl" },
    { "name": "ttl above range", "packet": "Checked", "hex": "beef 41 13 02 40 02 aabb",
      "error_kind": "constraint", "error_path": "Checked.ttl" },
    { "name": "ttl at the top of the range", "packet": "Checked", "hex": "beef 40 13 02 40 02 aabb",
      "expect": { "ttl": 64 } },
    { "name": "kind not in the category", "packet": "Checked", "hex": "beef 05 33 02 40 02 aabb",
      "error_kind": "constraint", "error_path": "Checked.kind" },
    { "name": "kind c", "packet": "Checked", "hex": "beef 05 93 02 40 02 aabb",
      "expect": { "kind": 9 } },
    { "name": "lenient range keeps the value", "packet": "Checked", "hex": "beef 05 1f 02 40 02 aabb",
      "expect": { "level": 15 } },
    { "name": "lenient magic keeps the value", "packet": "Checked", "hex": "beef 05 13 07 40 02 aabb",
      "expect": { "version": 7 } },
    { "name": "bitfield member out of range", "packet": "Checked", "hex": "beef 05 13 02 e0 02 aabb",
      "error_kind": "constraint", "error_path": "Checked.bits" },
    { "name": "bitfield magic member", "packet": "Checked", "hex": "beef 05 13 02 41 02 aabb",
      "error_kind": "constraint", "error_path": "Checked.bits" },
    { "name": "assertion with message", "packet": "Checked", "hex": "beef 05 13 02 40 05 aabbccddee",
      "error_kind": "constraint", "error_path": "Checked" },
    { "name": "assertion without message", "packet": "Checked", "hex": "beef 0d 13 02 40 02 aabb",
      "error_kind": "constraint", "error_path": "Checked" },
    { "name": "truncated before a checked field", "packet": "Checked", "hex": "beef",
      "error_kind": "incomplete", "error_path": "Checked.ttl" },
    { "name": "encode checks magic", "packet": "Checked", "hex": "beef 05 13 02 40 02 aabb",
      "set": { "magic": 0 }, "encode_error_kind": "constraint", "encode_error_path": "Checked.magic" },
    { "name": "encode checks category", "packet": "Checked", "hex": "beef 05 13 02 40 02 aabb",
      "set": { "kind": 3 }, "encode_error_kind": "constraint", "encode_error_path": "Checked.kind" },
    { "name": "encode checks range", "packet": "Checked", "hex": "beef 05 13 02 40 02 aabb",
      "set": { "ttl": 99 }, "encode_error_kind": "constraint", "encode_error_path": "Checked.ttl" },
    { "name": "encode checks assertions", "packet": "Checked", "hex": "beef 05 13 02 40 02 aabb",
      "set": { "ttl": 13 }, "encode_error_kind": "constraint", "encode_error_path": "Checked" },
    { "name": "encode keeps lenient values", "packet": "Checked", "hex": "beef 05 13 02 40 02 aabb",
      "set": { "level": 14, "version": 9 }, "encoded": "beef 05 1e 09 40 02 aabb" },

    { "name": "assert on calc", "packet": "WithCalc", "hex": "0102", "expect": { "sum": 3 } },
    { "name": "assert on calc fails", "packet": "WithCalc", "hex": "ffff",
      "error_kind": "constraint", "error_path": "WithCalc" },
    { "name": "encode assert on calc fails", "packet": "WithCalc", "hex": "0102",
      "set": { "a": 200, "b": 150 }, "encode_error_kind": "constraint" },

    { "name": "extreme magic values", "packet": "Extremes", "hex": "1032547698badcfe fe",
      "expect": { "big": 18364758544493064720, "neg": -2 } },
    { "name": "extreme magic values wrong", "packet": "Extremes", "hex": "1032547698badcfe fd",
      "error_kind": "constraint", "error_path": "Extremes.neg" }
  ]
}
