// Exercises every feature of the language. Used by tests/codegen.rs.

// The example from the bit field request: an 8-bit container with a 1-bit
// field, a 2-bit field, a 3-bit field and two bits of padding.
packet Flags8 {
  flags bitfield uint8 {
    one u1,
    two u2,
    three u3
  }
}

// Same container with the first member in the least significant bit.
packet Flags8Lsb {
  flags bitfield uint8 lsb {
    one u1,
    two u2,
    three u3
  }
}

// Little-endian 16-bit container with signed members and explicit padding.
packet Flags16 le {
  ctl bitfield uint16 {
    kind u4,
    _ u2,
    delta i5,
    level u5
  },
  tail uint8
}

// Integers of arbitrary bit width packed back to back, crossing byte
// boundaries, followed by a byte aligned field.
packet BitStream be {
  a u3,
  b u7,
  c i6,
  d u13,
  e u35,
  _ u4,
  f u24,
  _ u4,
  g u24 le,
  h uint16
}

// Bit-sized array elements and a count taken from a bit-sized field.
// u12[count * 2] always covers a whole number of bytes.
packet BitArrays {
  count u4,
  nibbles u4[3],
  values u12[count * 2],
  signed i3[2],
  _ u2
}

// Standard types, endianness overrides, arrays and calculated fields.
packet Scalars le {
  a int8,
  b uint16 be,
  c int32,
  d uint64 be,
  e float32,
  f float64 be,
  mac macaddress,
  stamp datetime,
  n uint8,
  words uint16[n] be,
  blob bytes[n * 2 - 1],
  calc total uint32 = sumof words + 1,
  calc big uint8 = when n > 2 then 1 otherwise 0,
  calc half float64 = sqrt(e) / 2,
  calc first uint16 = words[0],
  calc missing uint16 = words[100],
  calc ratio int16 = (c - 7) / 2,
  calc capped uint8 = min(n, 3) * max(1, 2) ^ 2
}

// A length computed from a calculated field declared after its use.
packet CalcLength be {
  n uint8,
  data bytes[size],
  calc size uint16 = n * 2
}

// Nested packets, arrays of nested packets and a rest-of-input array.
packet Item be {
  id uint16,
  len uint8,
  value bytes[len]
}

packet Container be {
  version u4,
  count u4,
  head Item,
  items Item[count],
  tail Item[]
}

// Field names that are keywords in some target languages.
packet Keywords {
  type uint8,
  class uint8,
  func uint8,
  struct uint8,
  default uint8,
  string uint8
}

// A rest-of-input array of 16-bit words.
packet Words be {
  count uint8,
  words uint16[]
}

// Named constants: every backend must emit these and compile them.
// Values cover hex/decimal/binary spellings, folded expressions, the
// extremes of 64-bit types, negative values and keyword-like names.
const MAGIC uint16 = 0xbeef "starts a Tagged packet; notes may contain */ and <tags> & such"
const DOUBLE_MAGIC uint32 = MAGIC * 2
const BITS uint8 = 0b1010
const U64_MAX uint64 = 0xffffffffffffffff
const I64_MIN int64 = -9223372036854775807 - 1
const NEGATIVE int8 = -128

const Kind u3 {
  none = 0,
  one = 1    "the first",
  class = 2,
  error = 7  "a Zig keyword",
}

const Color uint8 { red = 1, green = 2, blue = 3 }

// Fields tagged with the categories their values come from.
packet Tagged be {
  magic uint16,
  color uint8 : Color,
  flags bitfield uint8 { kind u3 : Kind, _ u5 },
  colors uint8[2] : Color,
  calc is_magic uint8 = magic == MAGIC,
  calc is_error uint8 = kind == Kind.error,
  calc doubled uint32 = DOUBLE_MAGIC + BITS
}

// Modulo, shifts, bitwise and unary operators.
packet Operators be {
  a int16,
  b uint8,
  calc rem int16 = a % 7,
  calc low uint8 = a & 0xff,
  calc high uint8 = (a >> 8) & 0xff,
  calc either uint16 = b << 8 | 0x0f,
  calc flipped uint8 = b xor 0xff,
  calc negated int16 = -a,
  calc inverted int16 = ~a,
  calc nonzero uint8 = not b == 0,
  calc wide uint8 = 1 << 64,
  calc sign int8 = a >> 70,
  calc zero int16 = a % 0,
  calc prec uint8 = 1 + 2 * 3 & 4 | 8,
  calc neg_pow int16 = -2 ^ 2,
  calc folded int8 = MINUS_TWO * 3
}

const MINUS_TWO int8 = -2
