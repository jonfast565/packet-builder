// ===============================
// Lexical conveniences
// ===============================
WHITESPACE = _{ " " | "\t" | "\n" | "\r\n" }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* }

// Basic character classes
alpha  = @{ 'a'..'z' | 'A'..'Z' }
digit  = @{ '0'..'9' }
bindig = @{ '0'..'1' }
hexdig = @{ '0'..'9' | 'a'..'f' | 'A'..'F' }
alnum  = @{ alpha | digit }
underscore = @{ "_" }

// ===============================
// Operators & punctuation (prefer longest-first)
// ===============================
plus   = @{ "+" }
minus  = @{ "-" }
mult   = @{ "*" }
div    = @{ "/" }
pw     = @{ "^" }
modulo = @{ "%" }
shl    = @{ "<<" }
shr    = @{ ">>" }
band   = @{ "&" }
bor    = @{ "|" }
bnot   = @{ "~" }

lparen = @{ "(" }
rparen = @{ ")" }
lbracket = @{ "{" }
rbracket = @{ "}" }
larray = @{ "[" }
rarray = @{ "]" }
comma  = @{ "," }
colon  = @{ ":" }
dot    = @{ "." }
assign = @{ "=" }          

gt   = @{ ">" ~ !">" }
gte  = @{ ">=" }
lt   = @{ "<" ~ !"<" }
lte  = @{ "<=" }          
eq   = @{ "==" }
neq  = @{ "!=" | "<>" }

// Logical
and_kw = @{ "and" }
or_kw  = @{ "or" }
not_kw = @{ "not" }
xor_kw = @{ "xor" }

// Aggregates / control
sumof_kw      = @{ "sumof" }
productof_kw  = @{ "productof" }
when_kw       = @{ "when" }
then_kw       = @{ "then" }
otherwise_kw  = @{ "otherwise" }

// Packet keywords
packet_kw     = @{ "packet" }
calc_kw       = @{ "calc" }
const_kw      = @{ "const" }

// Intrinsics
sqrt_kw = @{ "sqrt" }
min_kw  = @{ "min" }
max_kw  = @{ "max" }

// Endianness
le_kw = @{ "le" }
be_kw = @{ "be" }

// Bit fields
bitfield_kw = @{ "bitfield" }
msb_kw      = @{ "msb" }
lsb_kw      = @{ "lsb" }

// Layout
align_kw    = @{ "align" }
wordsize_kw = @{ "wordsize" }

// Validation. Only `assert` is reserved (it starts a rule); the others are
// only special after a field's type.
assert_kw  = @{ "assert" }
in_kw      = @{ "in" ~ !(alnum | underscore) }
strict_kw  = @{ "strict" ~ !(alnum | underscore) }
lenient_kw = @{ "lenient" ~ !(alnum | underscore) }
dotdot     = @{ ".." }

// ===============================
// Keyword reservation
// ===============================
keyword = _{
    packet_kw | calc_kw | const_kw
  | when_kw | then_kw | otherwise_kw
  | sumof_kw | productof_kw
  | and_kw | or_kw | not_kw | xor_kw
  | sqrt_kw | min_kw | max_kw
  | le_kw | be_kw
  | bitfield_kw | msb_kw | lsb_kw
  | align_kw | wordsize_kw | assert_kw
  // Type names are not reserved: they are only special in type position, so
  // a field may be called `word` or `string`.
}

// ===============================
// Identifiers & numbers
// ===============================
// Disallow keywords as identifiers:
identifier = @{
    !(keyword ~ !(alnum | underscore))
    ~ (alpha | underscore)
    ~ (alnum | underscore)*
}

// Numbers: decimal, hex (0x...), and binary (0b...)
numeric_constant = @{
      ("0x" ~ hexdig+)
    | ("0b" ~ bindig+)
    | (digit+ ~ ("." ~ digit+)?)
}

// ===============================
// Strings (JSON-style escapes)
// ===============================
string = ${ "\"" ~ inner ~ "\"" }
inner  = @{ char* }
char   = {
      !("\"" | "\\") ~ ANY
    | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t")
    | "\\" ~ ("u" ~ hexdig{4})
}

// ===============================
// Types
// ===============================
int8    = @{ "int8" }
uint8   = @{ "uint8" }
int16   = @{ "int16" }
uint16  = @{ "uint16" }
int32   = @{ "int32" }
uint32  = @{ "uint32" }
int64   = @{ "int64" }
uint64  = @{ "uint64" }
float32 = @{ "float32" }
float64 = @{ "float64" }
macaddr = @{ "macaddress" }
datetime= @{ "datetime" }
bytes_t = @{ "bytes" }     // raw byte blob

// Built-in type names. Each alternative carries its own word-boundary check
// so that e.g. "uint" does not match the start of "uint8" or "uint_count".
kw_end = _{ !(alnum | underscore) }
sp     = _{ (" " | "\t")+ }

char_t     = @{ "char" }
uchar_t    = @{ "uchar" | ("unsigned" ~ sp ~ "char") }
byte_t     = @{ "byte" }
short_t    = @{ "short" }
ushort_t   = @{ "ushort" | ("unsigned" ~ sp ~ "short") }
int_t      = @{ "int" }
uint_t     = @{ "uint" | ("unsigned" ~ sp ~ "int") }
halfword_t = @{ "halfword" | ("half" ~ sp ~ "word") }
word_t     = @{ "word" }
dword_t    = @{ "dword" | "doubleword" | ("double" ~ sp ~ "word") }
qword_t    = @{ "qword" | "quadword" | ("quad" ~ sp ~ "word") }
string_t   = @{ "string" }
cstring_t  = @{ "cstring" }

type_name = @{
    (uint8 | int8 | uint16 | int16 | uint32 | int32 | uint64 | int64
    | float32 | float64 | macaddr | datetime | bytes_t
    | uchar_t | char_t | byte_t | ushort_t | short_t | uint_t | int_t
    | halfword_t | word_t | dword_t | qword_t | cstring_t | string_t) ~ kw_end
}

// Arbitrary-width integers measured in bits: u1 .. u64 and i2 .. i64.
// They are read MSB-first from the bit stream and need no byte alignment.
bit_type = @{ ("u" | "i") ~ digit+ ~ !(alnum | underscore) }

// A reference to another packet declared in the same file.
packet_type = @{ identifier }

// A string preceded by its length: string(uint8), string(uint16 le), ...
prefixed_string = { string_t ~ lparen ~ (type_name | bit_type) ~ endianness? ~ rparen }

// Any type usable in a field declaration
field_type = { prefixed_string | type_name | bit_type | packet_type }

// Alignment in bytes, relative to the start of the packet
alignment = { align_kw ~ numeric_constant }

// Bit order inside a bitfield container (default msb: first member = highest bits)
bit_order = @{ msb_kw | lsb_kw }

// Endianness specifier (optional per packet/field)
endianness = @{ (le_kw | be_kw) ~ !(alnum | underscore) }

// ===============================
// Expressions, loosest first: or, and, not, comparison, |, xor, &, << >>,
// + -, * / %, unary - ~, ^, primary.
// ===============================
expr            = { bool_or }
bool_or         = { bool_and ~ (or_kw  ~ bool_and )* }
bool_and        = { bool_not ~ (and_kw ~ bool_not )* }
bool_not        = { not_kw* ~ cmp }
// Comparisons do not chain ("a < b < c" is a syntax error).
cmp             = { bit_or ~ ((neq|gte|lte|gt|lt|eq) ~ bit_or)? }
bit_or          = { bit_xor ~ (bor ~ bit_xor)* }
bit_xor         = { bit_and ~ (xor_kw ~ bit_and)* }
bit_and         = { shift ~ (band ~ shift)* }
shift           = { sum ~ ((shl | shr) ~ sum)* }
sum             = { product ~ ((plus | minus) ~ product)* }
product         = { unary   ~ ((mult | div | modulo) ~ unary)* }
unary           = { (minus | bnot)* ~ power }
power           = { primary ~ (pw ~ primary)? }

primary         = { guard_expression | literal | function_call | accessor | inner_expr }

inner_expr      = { lparen ~ expr ~ rparen }
literal         = { numeric_constant | string }

// Function calls
intrinsic_function = @{ sqrt_kw | min_kw | max_kw }
parameter_list = { lparen ~ (expr ~ (comma ~ expr)*)? ~ comma? ~ rparen } // allows trailing comma
function_call = { intrinsic_function ~ parameter_list }

// Accessors & declarations
declaration = {
    identifier ~ field_type ~ array_specifier? ~ endianness? ~ alignment? ~ category_tag? ~ constraint? ~ lenient_kw?
}

// `: Category` notes which named constants a field's values come from;
// `strict` rejects any other value.
category_tag = { colon ~ identifier ~ strict_kw? }

// `== MAGIC` (the field always holds this value) or `in 1..255` (inclusive).
constraint = { (eq ~ expr) | (in_kw ~ expr ~ dotdot ~ expr) }

// A fixed-size integer container split into named sub-fields:
//   flags bitfield uint8 { one u1, two u2, _ u5 }
// Bits not covered by members are padding. "_" names explicit padding.
bitfield_declaration = {
    identifier ~ bitfield_kw ~ (type_name | bit_type) ~ endianness? ~ bit_order? ~ alignment?
    ~ lbracket ~ bitfield_member ~ (comma ~ bitfield_member)* ~ comma? ~ rbracket
}
bitfield_member = { identifier ~ bit_type ~ category_tag? ~ constraint? ~ lenient_kw? }
accessor    = { aggregate_accessor | qualified_accessor | direct_value_accessor }

// `Category.member`: a named constant from a category.
qualified_accessor = { identifier ~ dot ~ identifier }

direct_value_accessor = { identifier ~ array_specifier? }
aggregate_accessor    = { (sumof_kw | productof_kw) ~ identifier ~ !larray }

// Arrays: allow dynamic length via full expr, not just numeric constant.
// An empty specifier ("[]") means "repeat until the end of the input" and is
// only valid on the last field of a packet.
array_specifier = { larray ~ expr? ~ rarray }

// Guarded (ternary-like) expression usable anywhere an expr is allowed
guard_expression = { when_kw ~ expr ~ then_kw ~ expr ~ otherwise_kw ~ expr }

// ===============================
// Named constants
// ===============================
// A standalone constant or a category of them, each with an optional note:
//   const FLAP_START uint8 = 0x2a "first byte of every frame"
//   const Channel uint8 { signon = 1, snac = 2 "SNAC data" }
const_decl   = { const_kw ~ identifier ~ (type_name | bit_type) ~ (const_value | const_group) }
const_value  = { assign ~ expr ~ string? }
const_group  = { lbracket ~ const_member ~ (comma ~ const_member)* ~ comma? ~ rbracket }
const_member = { identifier ~ assign ~ expr ~ string? }

// ===============================
// Packets
// ===============================
packets = { SOI ~ wordsize_directive? ~ (const_decl | packet)+ ~ EOI }

// Width of a `word` in bits (16 by default, x86 style; 32 for ARM style).
wordsize_directive = { wordsize_kw ~ numeric_constant }

// `align N` after the name lays fields out like a C struct packed to N bytes:
// every field is aligned to min(its natural alignment, N) and the packet is
// padded to a multiple of its alignment.
packet  = {
  packet_kw ~ identifier ~ endianness? ~ alignment? ~ lbracket ~ rule_list? ~ rbracket
}

rule_list = { rule ~ (comma ~ rule)* ~ comma? }

rule = { calculated_field | align_directive | assert_directive | bitfield_declaration | declaration }

// `assert expr "message"`: decoding and encoding fail when expr is false.
assert_directive = { assert_kw ~ expr ~ string? }

// Pad with zero bytes up to the next multiple of N bytes from the packet start.
align_directive = { align_kw ~ numeric_constant }

calculated_field = { calc_kw ~ identifier ~ (type_name | bit_type) ~ assign ~ expr }
