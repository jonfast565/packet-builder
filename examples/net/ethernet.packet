// Ethernet II frames. The EtherType picks the next header.

import "ip.packet"

const EtherType uint16 {
  ipv4 = 0x0800,
  arp = 0x0806,
  ipv6 = 0x86dd,
}

// Ethernet II frame.
packet Ethernet be {
  destination macaddress,
  source macaddress,
  ethertype uint16 : EtherType,
  payload switch ethertype {
    EtherType.ipv4 => ipv4 Ipv4,
    _ => other bytes[]
  }
}
