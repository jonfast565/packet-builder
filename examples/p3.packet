// =====================================================================
// P3 — the link protocol of the original America Online client
// (AOL 1.x-9.x for Windows and Mac; OSCAR came later, for AIM/ICQ).
//
// A P3 connection is a stream of packets: an 8-byte header, the data,
// and a carriage return. DATA packets carry a two-character "token"
// naming the message, followed by an FDO91 atom stream (FDO is AOL's
// form/display language). Everything is big-endian.
//
// The layout follows the open-source P3 client notaol
// (https://github.com/chfoo/notaol) and its captured INIT packet, checked
// against an AOL 4.0 client talking to aolserver
// (https://github.com/kachowtowmater/aolserver, whose re/NOTES.md
// documents the client's AOLP3 tool). See docs/p3.md for a walkthrough.
//
// The protocol's magic numbers are named constants below; generated code
// exports them (P3Type::DATA in Rust, P3TypeData in Go, ...).
// =====================================================================

// ---------------------------------------------------------------------
// Framing: any P3 packet
// ---------------------------------------------------------------------
const P3_SYNC uint8 = 0x5a "first byte of every packet ('Z')"
const P3_STOP uint8 = 0x0d "last byte of every packet (carriage return)"
const P3_LENGTH_OVERHEAD uint16 = 3 "`length` counts tx_seq, rx_seq and the type byte as well as the data"
const P3_SEQ_FIRST uint8 = 0x10 "sequence numbers run from P3_SEQ_FIRST to P3_SEQ_LAST, then wrap"
const P3_SEQ_LAST uint8 = 0x7f
const P3_NO_CRC uint16 = 0x2a2a "\"**\": AOL 4.0 over TCP sends this instead of a CRC once INIT is acknowledged"

// P3 packet types (the `type` member). Control packets carry no data, or
// a byte or two (RAK: 1 = re-init, 2 = connected). SS and SSR come from
// notaol; RESET, RAK, SETUP and ACKNOW from the AOL client's AOLP3 tool.
const P3Type u7 {
  data = 0x20       "numbered message carrying a token and FDO atoms",
  ss = 0x21         "ask the peer for a status report (SSR)",
  ssr = 0x22        "status report: lists messages to retransmit",
  init = 0x23       "first packet sent by the client",
  ack = 0x24        "acknowledge / null message",
  nak = 0x25        "a damaged or out-of-order packet was received",
  heartbeat = 0x26  "keep-alive; answer with an ACK",
  reset = 0x28      "reset (the client ignores it)",
  rak = 0x29        "reset acknowledge: data byte 1 = send INIT again, 2 = connected",
  setup = 0x2a      "setup",
  acknow = 0x2b     "acknowledge now",
}

// Every packet, whatever its type: the type picks how the body is read.
packet P3Packet be {
  sync uint8 == P3_SYNC,
  // CRC-16/ARC of everything from `length` up to the stop byte, or "**"
  // (AOL 4.0 over TCP, after INIT): decoders accept both, encoders write
  // "**" when `crc` holds it and the real CRC otherwise.
  crc uint16 = crc16_arc(length..body) placeholder P3_NO_CRC,
  length uint16 = sizeof(tx_seq..body),  // the body + P3_LENGTH_OVERHEAD
  tx_seq uint8,             // P3_SEQ_FIRST..P3_SEQ_LAST
  rx_seq uint8,             // last sequence number received from the other side
  kind bitfield uint8 {
    from_client u1,         // set on the client's packets, clear on the host's
    type u7 : P3Type strict
  },
  body switch type {
    P3Type.data => data P3Message,
    P3Type.init => init P3Init,
    _ => control bytes[]    // the control packets: usually empty
  } size length - P3_LENGTH_OVERHEAD,
  stop uint8 == P3_STOP
}

// ---------------------------------------------------------------------
// DATA packets (P3Type.data): a token, then an FDO atom stream
// ---------------------------------------------------------------------
const P3_TOKEN_LENGTH uint16 = 2 "every DATA packet starts with a two-character token"

// The body of a DATA packet.
packet P3Message be {
  token char[P3_TOKEN_LENGTH],  // e.g. "Dd" (login), "SD" (go ahead after INIT), "AA" (chat)
  atoms bytes[]                 // FDO91 atom stream; see FdoStream
}

// ---------------------------------------------------------------------
// INIT (P3Type.init): the client describes itself
// ---------------------------------------------------------------------
const Platform uint8 {
  windows = 0x03,
  macintosh = 0x0c,
}

const P3_INIT_LENGTH uint16 = 55 "P3Packet.length of an AOL 4.0 (or later) INIT packet: 52 bytes of INIT data"

// How many bytes follow P3Init.num_colors: the INIT layout of each client
// generation (Windows clients; Wireshark's AOL dissector and penggy's
// p3_init30_t / p3_init40_t; notaol and Dialtone agree on 49 and 52 bytes).
const P3InitLayout uint8 {
  aol15 = 11  "AOL 1.5: 48 bytes of INIT data",
  aol30 = 12  "AOL 2.5 to 3.0: 49 bytes (adds `filler`)",
  aol40 = 15  "AOL 4.0 and later: 52 bytes (adds `unknown`, `speed` is 16-bit)",
}

// The INIT data. Field names follow notaol and penggy. Multi-byte fields
// are little-endian (Wireshark, penggy; a captured AOL 4.0 INIT holds its
// 1152x864 screen there); the DOS and Windows versions are major, minor
// bytes. client_major names the client (penggy's table): 109-110 AOL 3.0
// 16-bit, 130-139 3.0 32-bit, 134-135 and 148-153 4.0 32-bit, 156-185 5.0,
// 190 and up 6.0. Mac clients (platform 0x0c) send another, undocumented
// layout (Dialtone).
packet P3Init le {
  platform uint8 : Platform,
  client_major uint8,       // client internal version (see above)
  client_minor uint8,
  build_num uint8,          // used from AOL 5.0
  machine_memory uint8,
  app_memory uint8,
  pc_type uint16,
  release_month uint8,
  release_day uint8,
  customer_class uint16,
  timestamp uint32,         // update-disk (UDO) timestamp
  dos_major uint8,
  dos_minor uint8,
  session_flags uint16,
  video_type uint8,
  cpu_type uint8,
  media_type uint32,
  windows_major uint8,
  windows_minor uint8,
  unknown1 uint16,
  windows_mem_type uint8,
  horizontal_res uint16,
  vertical_res uint16,
  num_colors uint16,
  // The rest depends on the client: its length says which.
  calc tail_length uint8 = remaining,
  tail switch tail_length {
    P3InitLayout.aol15 => aol15 P3InitTail15,
    P3InitLayout.aol30 => aol30 P3InitTail30,
    _ => aol40 P3InitTail40   // 4.0 and later
  }
}

packet P3InitTail15 le {
  region uint16,
  languages uint16[4],
  speed uint8
}

packet P3InitTail30 le {
  filler uint8,
  region uint16,
  languages uint16[4],
  speed uint8               // connection speed
}

packet P3InitTail40 le {
  filler uint8,
  region uint16,
  languages uint16[4],
  unknown2 uint16,
  speed uint16
}

// ---------------------------------------------------------------------
// FDO91 atom streams (the data after a DATA packet's token)
// ---------------------------------------------------------------------
// Each atom starts with a byte holding a 3-bit compression style and a
// 5-bit value. Style 0, the form clients send, is uncompressed:
// protocol, atom number, argument length, argument. The length takes one
// byte below 0x80 and two (0x80 | n >> 8, n & 0xff) above, as the host's
// long alerts and Welcome streams need (`varint15`). The compressed styles
// 1-7 change the layout and are not modelled here; `uncompressed` flags
// them so a caller can stop.
const FdoStyle u3 {
  full = 0  "uncompressed: protocol, atom number, argument length, argument",
}

const FdoProtocol u5 {
  uni = 0  "universal atoms (streams, data handling)",
  man = 1  "form manager",
  de = 3   "display editor",
}

packet FdoAtom be {
  head bitfield uint8 {
    style u3 : FdoStyle,
    protocol u5 : FdoProtocol
  },
  atom uint8,               // atom number within the protocol
  arg_length varint15 = len(arg),  // 1 byte below 0x80, else 2 with the top bit set
  arg bytes[arg_length],
  calc uncompressed uint8 = style == FdoStyle.full
}

packet FdoStream be {
  stream_id uint16,
  atoms FdoAtom[]
}

// A Wireshark dissector (`packet_builder dissector examples/p3.packet -o out`).
// P3 has no port of its own, so Wireshark tries it on TCP and UDP payloads and
// keeps it when the sync byte, type bit and type check out.
dissector P3Packet { name "AOL P3", abbrev "aolp3", heuristic }
