// =====================================================================
// P3 — the link protocol of the original America Online client
// (AOL 1.x-9.x for Windows and Mac; OSCAR came later, for AIM/ICQ).
//
// A P3 connection is a stream of packets: an 8-byte header, the data,
// and a carriage return. DATA packets carry a two-character "token"
// naming the message, followed by an FDO91 atom stream (FDO is AOL's
// form/display language). Everything is big-endian.
//
// The layout follows the open-source P3 client notaol
// (https://github.com/chfoo/notaol) and its captured INIT packet.
// See docs/p3.md for a walkthrough.
//
// The protocol's magic numbers are named constants below; generated code
// exports them (P3Type::DATA in Rust, P3TypeData in Go, ...).
// =====================================================================

// ---------------------------------------------------------------------
// Framing: any P3 packet
// ---------------------------------------------------------------------
const P3_SYNC uint8 = 0x5a "first byte of every packet ('Z')"
const P3_STOP uint8 = 0x0d "last byte of every packet (carriage return)"
const P3_LENGTH_OVERHEAD uint16 = 3 "`length` counts tx_seq, rx_seq and the type byte as well as the data"
const P3_SEQ_FIRST uint8 = 0x10 "sequence numbers run from P3_SEQ_FIRST to P3_SEQ_LAST, then wrap"
const P3_SEQ_LAST uint8 = 0x7f

// P3 packet types (the `type` member). Control packets (SS, SSR, ACK,
// NAK, HEARTBEAT) carry no data.
const P3Type u7 {
  data = 0x20       "numbered message carrying a token and FDO atoms",
  ss = 0x21         "ask the peer for a status report (SSR)",
  ssr = 0x22        "status report: lists messages to retransmit",
  init = 0x23       "first packet sent by the client",
  ack = 0x24        "acknowledge / null message",
  nak = 0x25        "a damaged or out-of-order packet was received",
  heartbeat = 0x26  "keep-alive; answer with an ACK",
}

packet P3Packet be {
  sync uint8,               // always P3_SYNC
  crc uint16,               // CRC-16/ARC of everything from `length` up to the stop byte
  length uint16,            // data bytes + P3_LENGTH_OVERHEAD
  tx_seq uint8,             // P3_SEQ_FIRST..P3_SEQ_LAST
  rx_seq uint8,             // last sequence number received from the other side
  kind bitfield uint8 {
    always_set u1,          // the high bit of the type byte is always 1
    type u7 : P3Type
  },
  data bytes[length - P3_LENGTH_OVERHEAD],
  stop uint8,               // always P3_STOP
  calc valid uint8 = sync == P3_SYNC and stop == P3_STOP and always_set == 1
                     and type >= P3Type.data and type <= P3Type.heartbeat
                     and length >= P3_LENGTH_OVERHEAD
}

// ---------------------------------------------------------------------
// DATA packets (P3Type.data): a token, then an FDO atom stream
// ---------------------------------------------------------------------
const P3_TOKEN_LENGTH uint16 = 2 "every DATA packet starts with a two-character token"

packet P3DataPacket be {
  sync uint8,
  crc uint16,
  length uint16,
  tx_seq uint8,
  rx_seq uint8,
  kind bitfield uint8 { always_set u1, type u7 : P3Type },
  token char[P3_TOKEN_LENGTH],  // e.g. "Dd" (login), "SD" (go ahead after INIT), "AA" (chat)
  atoms bytes[length - P3_LENGTH_OVERHEAD - P3_TOKEN_LENGTH],  // FDO91 atom stream; see FdoStream
  stop uint8
}

// The data of a DATA packet on its own.
packet P3Message be {
  token char[P3_TOKEN_LENGTH],
  atoms bytes[]
}

// ---------------------------------------------------------------------
// INIT (P3Type.init): the client describes itself
// ---------------------------------------------------------------------
const Platform uint8 {
  windows = 0x03,
  macintosh = 0x0c,
}

const P3_INIT_LENGTH uint16 = 55 "P3InitPacket.length for the 52-byte INIT data"

// The 52-byte form seen in a captured AOL client session. Field names
// follow notaol. Only platform, client version, session_flags, num_colors
// and speed are confirmed by notaol's tests; the rest are its best guesses
// (in the capture, horizontal_res/vertical_res do not hold a resolution).
packet P3Init be {
  platform uint8 : Platform,
  client_major uint8,       // client internal version
  client_minor uint8,
  build_num uint8,
  machine_memory uint8,
  app_memory uint8,
  pc_type uint16,
  release_month uint8,
  release_day uint8,
  customer_class uint16,
  timestamp uint32,         // update-disk (UDO) timestamp
  dos_major uint8,
  dos_minor uint8,
  session_flags uint16,
  video_type uint8,
  cpu_type uint8,
  media_type uint32,
  windows_major uint8,
  windows_minor uint8,
  unknown1 uint16,
  windows_mem_type uint8,
  horizontal_res uint16,
  vertical_res uint16,
  num_colors uint16,
  filler1 uint8,
  region uint16,
  language_1 uint16,
  language_2 uint16,
  language_3 uint16,
  language_4 uint16,
  unknown2 uint16,
  speed uint16
}

// A complete INIT packet in one pass.
packet P3InitPacket be {
  sync uint8,
  crc uint16,
  length uint16,            // P3_INIT_LENGTH
  tx_seq uint8,
  rx_seq uint8,
  kind bitfield uint8 { always_set u1, type u7 : P3Type },
  init P3Init,
  stop uint8
}

// ---------------------------------------------------------------------
// FDO91 atom streams (the data after a DATA packet's token)
// ---------------------------------------------------------------------
// Each atom starts with a byte holding a 3-bit compression style and a
// 5-bit value. Style 0, the form clients send, is uncompressed:
// protocol, atom number, argument length, argument. The compressed styles
// 1-7 change the layout and are not modelled here; `uncompressed` flags
// them so a caller can stop.
const FdoStyle u3 {
  full = 0  "uncompressed: protocol, atom number, argument length, argument",
}

const FdoProtocol u5 {
  uni = 0  "universal atoms (streams, data handling)",
  man = 1  "form manager",
  de = 3   "display editor",
}

packet FdoAtom be {
  head bitfield uint8 {
    style u3 : FdoStyle,
    protocol u5 : FdoProtocol
  },
  atom uint8,               // atom number within the protocol
  arg_length uint8,
  arg bytes[arg_length],
  calc uncompressed uint8 = style == FdoStyle.full
}

packet FdoStream be {
  stream_id uint16,
  atoms FdoAtom[]
}
