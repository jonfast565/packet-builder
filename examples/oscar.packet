// =====================================================================
// OSCAR — the protocol behind AOL Instant Messenger (AIM) and ICQ.
//
// An OSCAR connection is a TCP stream of FLAP frames. Channel 2 frames
// carry SNACs (a 10-byte header + a family/subtype specific body); most
// SNAC bodies are chains of TLVs. Everything is big-endian.
//
// Decoding a Flap decodes all of it: the FLAP channel picks the payload
// type, and the SNAC family and subtype pick the body type (tagged unions,
// `switch`). Lengths are derived, so encoders compute them.
//   bytes --Flap--> Snac --body--> ServerReady / IcbmReceive / ... --> TLVs
// See docs/oscar.md for a walkthrough.
//
// The protocol's magic numbers are named constants below; generated code
// exports them (Channel::SNAC in Rust, ChannelSnac in Go, ...).
// =====================================================================

// Protocol versions: the OService family version a client negotiates.
// Version 1 (AIM 1.x clients) gets shorter rate classes (RateClass); 2 is
// everyone else, and the default.
version 2

// ---------------------------------------------------------------------
// FLAP: framing layer
// ---------------------------------------------------------------------
const FLAP_START uint8 = 0x2a "first byte of every FLAP frame ('*')"

const Channel uint8 {
  signon = 1        "sign-on: FlapSignon payload",
  snac = 2          "SNAC data: Snac payload",
  error = 3         "FLAP-level error",
  signoff = 4       "sign-off",
  keep_alive = 5    "keep-alive",
}

packet Flap be {
  start uint8 == FLAP_START,
  channel uint8 : Channel strict,
  sequence uint16,          // per-direction sequence number
  length uint16 = sizeof(payload),
  payload switch channel {
    Channel.signon => signon FlapSignon,
    Channel.snac => snac Snac,
    _ => other bytes[]      // error, sign-off and keep-alive frames
  } size length
}

const FLAP_VERSION uint32 = 1 "FlapSignon.version is always 1"

// TLV types of the sign-on and authorization exchange (FlapSignon,
// AuthKeyRequest, LoginRequest, LoginResponse).
const LoginTlv uint16 {
  screen_name = 0x0001       "the screen name",
  roasted_password = 0x0002  "XOR-roasted password (AIM 1.x-3.x FLAP sign-on)",
  client_id = 0x0003         "client identity string",
  reconnect_here = 0x0005    "BOS address to connect to, \"host:port\" (LoginResponse)",
  auth_cookie = 0x0006       "authorization cookie handed out by the login server",
  error_subcode = 0x0008     "why the login failed, a uint16 (LoginResponse)",
  password_hash = 0x0025     "MD5 hash of the password and the AuthKeyResponse key (LoginRequest)",
  use_strong_hash = 0x004c   "the hash is the strong one: MD5 of the password's MD5 (empty)",
}

// Channel 1 payload (sign-on): protocol version, then TLVs such as
// LoginTlv.auth_cookie.
packet FlapSignon be {
  version uint32 == FLAP_VERSION,
  tlvs Tlv[]
}

// ---------------------------------------------------------------------
// TLV: type / length / value
// ---------------------------------------------------------------------
packet Tlv be {
  type uint16,
  length uint16 = len(value),
  value bytes[length]
}

// ---------------------------------------------------------------------
// SNAC: a 10-byte header, then a body picked by family and subtype
// ---------------------------------------------------------------------
const SnacFamily uint16 {
  service = 0x0001  "generic service controls",
  icbm = 0x0004     "ICBM: instant messages",
  stats = 0x000b    "usage statistics reports",
  auth = 0x0017     "authorization (MD5 login)",
}

// The flag bits as masks over the 16-bit flags word.
const SnacFlag uint16 {
  has_version_info = 0x8000  "a length-prefixed TLV block follows the header",
  more_replies = 0x0001      "more SNACs answer the same request",
}

packet Snac be {
  family uint16 : SnacFamily,
  subtype uint16,           // ServiceSubtype, AuthSubtype, IcbmSubtype or StatsSubtype, by family
  flags bitfield uint16 {
    has_version_info u1,    // SnacFlag.has_version_info
    _ u14,
    more_replies u1         // SnacFlag.more_replies
  },
  request_id uint32,
  // Present only when has_version_info is set: an array of 0 or 1 entries.
  version_info SnacVersionInfo[has_version_info],
  // The selector combines family and subtype into one 32-bit number.
  body switch family << 16 | subtype {
    SnacFamily.service << 16 | ServiceSubtype.client_online => client_online ClientOnline,
    SnacFamily.service << 16 | ServiceSubtype.server_ready => server_ready ServerReady,
    SnacFamily.service << 16 | ServiceSubtype.rate_request => rate_request,
    SnacFamily.service << 16 | ServiceSubtype.rate_info => rate_info RateInfo,
    SnacFamily.service << 16 | ServiceSubtype.rate_ack => rate_ack RateAck,
    SnacFamily.service << 16 | ServiceSubtype.motd => motd Motd,
    SnacFamily.service << 16 | ServiceSubtype.client_versions,
    SnacFamily.service << 16 | ServiceSubtype.server_versions => family_versions FamilyVersions,
    SnacFamily.auth << 16 | AuthSubtype.login_request => login_request LoginRequest,
    SnacFamily.auth << 16 | AuthSubtype.login_response => login_response LoginResponse,
    SnacFamily.auth << 16 | AuthSubtype.key_request => key_request AuthKeyRequest,
    SnacFamily.auth << 16 | AuthSubtype.key_response => key_response AuthKeyResponse,
    SnacFamily.icbm << 16 | IcbmSubtype.error => icbm_error SnacError,
    SnacFamily.icbm << 16 | IcbmSubtype.send => send IcbmSend,
    SnacFamily.icbm << 16 | IcbmSubtype.receive => receive IcbmReceive,
    SnacFamily.icbm << 16 | IcbmSubtype.host_ack => host_ack IcbmHostAck,
    SnacFamily.stats << 16 | StatsSubtype.report_interval => report_interval StatsReportInterval,
    _ => other bytes[]
  }
}

packet SnacVersionInfo be {
  length uint16 = len(tlvs),
  tlvs bytes[length]
}

// Error codes of the error SNACs (subtype 0x01 of every family).
const SnacErrorCode uint16 {
  invalid_snac = 0x01             "invalid SNAC header",
  rate_to_host = 0x02             "server rate limit exceeded",
  rate_to_client = 0x03           "client rate limit exceeded",
  not_logged_on = 0x04            "recipient is not logged in",
  service_unavailable = 0x05      "requested service unavailable",
  service_not_defined = 0x06      "requested service not defined",
  obsolete_snac = 0x07            "obsolete SNAC",
  not_supported_by_host = 0x08    "not supported by the server",
  not_supported_by_client = 0x09  "not supported by the client",
  refused_by_client = 0x0a        "refused by the client",
  in_local_permit_deny = 0x10     "blocked by the recipient's permit/deny list",
  too_evil_sender = 0x11          "sender's warning level too high",
  too_evil_receiver = 0x12        "recipient's warning level too high",
  user_temp_unavail = 0x13        "recipient temporarily unavailable",
}

// An error SNAC: a code, then optional TLVs (such as an error subcode).
packet SnacError be {
  code uint16 : SnacErrorCode,
  tlvs Tlv[]
}

// ---------------------------------------------------------------------
// Family 0x0001 (SnacFamily.service): generic service controls
// ---------------------------------------------------------------------
const ServiceSubtype uint16 {
  client_online = 0x02    "ClientOnline",
  server_ready = 0x03     "ServerReady",
  rate_request = 0x06     "rate information request (no body)",
  rate_info = 0x07        "RateInfo",
  rate_ack = 0x08         "RateAck",
  motd = 0x13             "Motd (message of the day)",
  client_versions = 0x17  "FamilyVersions sent by the client",
  server_versions = 0x18  "FamilyVersions sent by the server",
}

// SNAC(01,02) client online: sent once sign-on is done, one entry per family.
packet ClientFamily be {
  family uint16,
  version uint16,
  tool_id uint16,
  tool_version uint16
}

packet ClientOnline be {
  families ClientFamily[]
}

// SNAC(01,03) server ready: the families this connection serves.
packet ServerReady be {
  families uint16[]
}

// SNAC(01,17) client / SNAC(01,18) server: family versions.
packet FamilyVersion be {
  family uint16,
  version uint16
}

packet FamilyVersions be {
  versions FamilyVersion[]
}

// SNAC(01,07) rate limit information. Its classes have two layouts: v1
// (AIM 1.x clients, 30 bytes) and v2 (everyone else: `last_time` and
// `state` follow, 35 bytes). Nothing in the SNAC says which: the server
// picks by the OService family version the client negotiated in
// SNAC(01,17)/(01,18) (Open OSCAR Server), or by the client id sent at
// login (Retro AIM Server; foodgroup/oservice.go). That is this file's
// protocol version (`version 2` above): a client decodes its connection at
// the version it negotiated; tools default to v2.
packet RateClass be {
  id uint16,
  window_size uint32,
  clear_level uint32,
  alert_level uint32,
  limit_level uint32,
  disconnect_level uint32,
  current_level uint32,
  max_level uint32,
  @2 last_time uint32,      // v2 only
  @2 state uint8
}

packet FamilySubtype be {
  family uint16,
  subtype uint16
}

packet RateGroup be {
  class_id uint16,
  pair_count uint16 = len(pairs),
  pairs FamilySubtype[pair_count]
}

packet RateInfo be {
  class_count uint16 = len(classes),
  classes RateClass[class_count],
  groups RateGroup[]
}

// SNAC(01,08) the client accepts these rate classes (RateClass.id).
packet RateAck be {
  class_ids uint16[]
}

// SNAC(01,13) message of the day: a MotdType, then TLVs (MotdTlv).
const MotdType uint16 {
  mandatory_upgrade = 0x0001  "the client must be upgraded",
  advisory_upgrade = 0x0002   "an upgrade is recommended",
  announcement = 0x0003       "system announcement",
  standard = 0x0004           "standard notice (sent at every sign-on)",
  news = 0x0006               "news from the service",
}

const MotdTlv uint16 {
  message = 0x000b  "the message text",
}

packet Motd be {
  type uint16 : MotdType,
  tlvs Tlv[]
}

// ---------------------------------------------------------------------
// Family 0x000B (SnacFamily.stats): usage statistics
// ---------------------------------------------------------------------
const StatsSubtype uint16 {
  error = 0x01            "SnacError (not modelled; stays in Snac.body.other)",
  report_interval = 0x02  "StatsReportInterval",
  report_events = 0x03    "client statistics, TLVs (not modelled)",
  report_ack = 0x04       "the server got the report (no body; not modelled)",
}

// SNAC(0B,02) the minimum interval between the client's statistics reports
// (Open OSCAR Server sends 1).
packet StatsReportInterval be {
  interval uint16
}

// ---------------------------------------------------------------------
// Family 0x0017 (SnacFamily.auth): authorization (MD5 login)
// ---------------------------------------------------------------------
const AuthSubtype uint16 {
  login_request = 0x02   "LoginRequest",
  login_response = 0x03  "LoginResponse",
  key_request = 0x06     "AuthKeyRequest",
  key_response = 0x07    "AuthKeyResponse",
}

// SNAC(17,06) request an MD5 salt; LoginTlv.screen_name carries the screen name.
packet AuthKeyRequest be {
  tlvs Tlv[]
}

// SNAC(17,07) the salt to hash the password with.
packet AuthKeyResponse be {
  key_length uint16 = len(key),
  key bytes[key_length]
}

// SNAC(17,02) log in: LoginTlv.screen_name, client_id, password_hash and
// use_strong_hash (plus client version TLVs).
packet LoginRequest be {
  tlvs Tlv[]
}

// SNAC(17,03) the answer: LoginTlv.reconnect_here and auth_cookie on
// success, LoginTlv.error_subcode on failure. Unknown screen names get it in
// place of an AuthKeyResponse.
packet LoginResponse be {
  tlvs Tlv[]
}

// ---------------------------------------------------------------------
// Family 0x0004 (SnacFamily.icbm): ICBM (instant messages)
// ---------------------------------------------------------------------
const IcbmSubtype uint16 {
  error = 0x01     "SnacError, e.g. SnacErrorCode.not_logged_on",
  send = 0x06      "IcbmSend",
  receive = 0x07   "IcbmReceive",
  host_ack = 0x0c  "IcbmHostAck",
}

const IcbmChannel uint16 {
  plain_text = 1  "plain text: an IcbmMessage in IcbmTlv.message_data",
  rendezvous = 2  "rendezvous (file transfer, direct connect, ...)",
  icq = 4         "ICQ-style message",
}

const IcbmTlv uint16 {
  message_data = 0x0002      "an IcbmMessage",
  request_host_ack = 0x0003  "answer with an IcbmHostAck (empty)",
  store_offline = 0x0006     "store the message if the recipient is offline (empty)",
}

// SNAC(04,06) send a message (client to server).
packet IcbmSend be {
  cookie bytes[8],          // random message id, echoed in acks
  channel uint16 : IcbmChannel,
  screen_name string(uint8),  // length-prefixed: one length byte, then the name
  tlvs Tlv[]                // IcbmTlv types
}

// SNAC(04,07) incoming message (server to client).
packet IcbmReceive be {
  cookie bytes[8],
  channel uint16 : IcbmChannel,
  screen_name string(uint8),
  warning_level uint16,     // sender's warning level in tenths of a percent
  user_tlv_count uint16 = len(user_tlvs),
  user_tlvs Tlv[user_tlv_count],
  tlvs Tlv[],
  calc warning_percent float64 = warning_level / 10.0
}

// SNAC(04,0C) the server took a message sent with IcbmTlv.request_host_ack.
packet IcbmHostAck be {
  cookie bytes[8],          // the IcbmSend's cookie
  channel uint16 : IcbmChannel,
  screen_name string(uint8)  // the recipient
}

// Value of IcbmTlv.message_data in an IcbmChannel.plain_text message: a
// list of fragments.
const FragmentId uint8 {
  text = 0x01          "the text: MessageText",
  capabilities = 0x05  "capabilities the sender supports",
}

packet IcbmFragment be {
  id uint8 : FragmentId,
  version uint8,
  length uint16 = sizeof(data),
  data switch id {
    FragmentId.text => text MessageText,
    _ => other bytes[]       // FragmentId.capabilities, ...
  } size length
}

packet IcbmMessage be {
  fragments IcbmFragment[]
}

// Data of fragment FragmentId.text.
const Charset uint16 {
  ascii = 0x0000       "US-ASCII",
  ucs2be = 0x0002      "UCS-2, big-endian",
  iso_8859_1 = 0x0003  "ISO-8859-1",
}

packet MessageText be {
  charset uint16 : Charset,
  charsubset uint16,
  text bytes[]
}

// A Wireshark dissector: `packet_builder dissector examples/oscar.packet -o out`
// writes oscar.lua. TCP port 5190 is AIM's; frames split across segments are
// reassembled, since a FLAP's length is in its header.
dissector Flap { name "AIM OSCAR", abbrev "oscar", tcp.port 5190 }
