// =====================================================================
// OSCAR — the protocol behind AOL Instant Messenger (AIM) and ICQ.
//
// An OSCAR connection is a TCP stream of FLAP frames. Channel 2 frames
// carry SNACs (a 10-byte header + a family/subtype specific body); most
// SNAC bodies are chains of TLVs. Everything is big-endian.
//
// Decoding a Flap decodes all of it: the FLAP channel picks the payload
// type, and the SNAC family and subtype pick the body type (tagged unions,
// `switch`). Lengths are derived, so encoders compute them.
//   bytes --Flap--> Snac --body--> ServerReady / IcbmReceive / ... --> TLVs
// See docs/oscar.md for a walkthrough.
//
// The protocol's magic numbers are named constants below; generated code
// exports them (Channel::SNAC in Rust, ChannelSnac in Go, ...).
// =====================================================================

// ---------------------------------------------------------------------
// FLAP: framing layer
// ---------------------------------------------------------------------
const FLAP_START uint8 = 0x2a "first byte of every FLAP frame ('*')"

const Channel uint8 {
  signon = 1        "sign-on: FlapSignon payload",
  snac = 2          "SNAC data: Snac payload",
  error = 3         "FLAP-level error",
  signoff = 4       "sign-off",
  keep_alive = 5    "keep-alive",
}

packet Flap be {
  start uint8 == FLAP_START,
  channel uint8 : Channel strict,
  sequence uint16,          // per-direction sequence number
  length uint16 = sizeof(payload),
  payload switch channel {
    Channel.signon => signon FlapSignon,
    Channel.snac => snac Snac,
    _ => other bytes[]      // error, sign-off and keep-alive frames
  } size length
}

const FLAP_VERSION uint32 = 1 "FlapSignon.version is always 1"

// TLV types of the sign-on and authorization exchange.
const LoginTlv uint16 {
  screen_name = 0x0001  "the screen name (AuthKeyRequest)",
  auth_cookie = 0x0006  "authorization cookie handed out by the login server",
}

// Channel 1 payload (sign-on): protocol version, then TLVs such as
// LoginTlv.auth_cookie.
packet FlapSignon be {
  version uint32 == FLAP_VERSION,
  tlvs Tlv[]
}

// ---------------------------------------------------------------------
// TLV: type / length / value
// ---------------------------------------------------------------------
packet Tlv be {
  type uint16,
  length uint16 = len(value),
  value bytes[length]
}

// ---------------------------------------------------------------------
// SNAC: a 10-byte header, then a body picked by family and subtype
// ---------------------------------------------------------------------
const SnacFamily uint16 {
  service = 0x0001  "generic service controls",
  icbm = 0x0004     "ICBM: instant messages",
  auth = 0x0017     "authorization (MD5 login)",
}

// The flag bits as masks over the 16-bit flags word.
const SnacFlag uint16 {
  has_version_info = 0x8000  "a length-prefixed TLV block follows the header",
  more_replies = 0x0001      "more SNACs answer the same request",
}

packet Snac be {
  family uint16 : SnacFamily,
  subtype uint16,           // ServiceSubtype, AuthSubtype or IcbmSubtype, by family
  flags bitfield uint16 {
    has_version_info u1,    // SnacFlag.has_version_info
    _ u14,
    more_replies u1         // SnacFlag.more_replies
  },
  request_id uint32,
  // Present only when has_version_info is set: an array of 0 or 1 entries.
  version_info SnacVersionInfo[has_version_info],
  // The selector combines family and subtype into one 32-bit number.
  body switch family << 16 | subtype {
    SnacFamily.service << 16 | ServiceSubtype.server_ready => server_ready ServerReady,
    SnacFamily.service << 16 | ServiceSubtype.rate_info => rate_info RateInfo,
    SnacFamily.service << 16 | ServiceSubtype.client_versions,
    SnacFamily.service << 16 | ServiceSubtype.server_versions => family_versions FamilyVersions,
    SnacFamily.auth << 16 | AuthSubtype.key_request => key_request AuthKeyRequest,
    SnacFamily.auth << 16 | AuthSubtype.key_response => key_response AuthKeyResponse,
    SnacFamily.icbm << 16 | IcbmSubtype.send => send IcbmSend,
    SnacFamily.icbm << 16 | IcbmSubtype.receive => receive IcbmReceive,
    _ => other bytes[]
  }
}

packet SnacVersionInfo be {
  length uint16 = len(tlvs),
  tlvs bytes[length]
}

// ---------------------------------------------------------------------
// Family 0x0001 (SnacFamily.service): generic service controls
// ---------------------------------------------------------------------
const ServiceSubtype uint16 {
  server_ready = 0x03     "ServerReady",
  rate_info = 0x07        "RateInfo",
  client_versions = 0x17  "FamilyVersions sent by the client",
  server_versions = 0x18  "FamilyVersions sent by the server",
}

// SNAC(01,03) server ready: the families this connection serves.
packet ServerReady be {
  families uint16[]
}

// SNAC(01,17) client / SNAC(01,18) server: family versions.
packet FamilyVersion be {
  family uint16,
  version uint16
}

packet FamilyVersions be {
  versions FamilyVersion[]
}

// SNAC(01,07) rate limit information.
packet RateClass be {
  id uint16,
  window_size uint32,
  clear_level uint32,
  alert_level uint32,
  limit_level uint32,
  disconnect_level uint32,
  current_level uint32,
  max_level uint32,
  last_time uint32,
  state uint8
}

packet FamilySubtype be {
  family uint16,
  subtype uint16
}

packet RateGroup be {
  class_id uint16,
  pair_count uint16 = len(pairs),
  pairs FamilySubtype[pair_count]
}

packet RateInfo be {
  class_count uint16 = len(classes),
  classes RateClass[class_count],
  groups RateGroup[]
}

// ---------------------------------------------------------------------
// Family 0x0017 (SnacFamily.auth): authorization (MD5 login)
// ---------------------------------------------------------------------
const AuthSubtype uint16 {
  key_request = 0x06   "AuthKeyRequest",
  key_response = 0x07  "AuthKeyResponse",
}

// SNAC(17,06) request an MD5 salt; LoginTlv.screen_name carries the screen name.
packet AuthKeyRequest be {
  tlvs Tlv[]
}

// SNAC(17,07) the salt to hash the password with.
packet AuthKeyResponse be {
  key_length uint16 = len(key),
  key bytes[key_length]
}

// ---------------------------------------------------------------------
// Family 0x0004 (SnacFamily.icbm): ICBM (instant messages)
// ---------------------------------------------------------------------
const IcbmSubtype uint16 {
  send = 0x06     "IcbmSend",
  receive = 0x07  "IcbmReceive",
}

const IcbmChannel uint16 {
  plain_text = 1  "plain text: an IcbmMessage in IcbmTlv.message_data",
  rendezvous = 2  "rendezvous (file transfer, direct connect, ...)",
  icq = 4         "ICQ-style message",
}

const IcbmTlv uint16 {
  message_data = 0x0002   "an IcbmMessage",
  store_offline = 0x0006  "store the message if the recipient is offline (empty)",
}

// SNAC(04,06) send a message (client to server).
packet IcbmSend be {
  cookie bytes[8],          // random message id, echoed in acks
  channel uint16 : IcbmChannel,
  screen_name string(uint8),  // length-prefixed: one length byte, then the name
  tlvs Tlv[]                // IcbmTlv types
}

// SNAC(04,07) incoming message (server to client).
packet IcbmReceive be {
  cookie bytes[8],
  channel uint16 : IcbmChannel,
  screen_name string(uint8),
  warning_level uint16,     // sender's warning level in tenths of a percent
  user_tlv_count uint16 = len(user_tlvs),
  user_tlvs Tlv[user_tlv_count],
  tlvs Tlv[],
  calc warning_percent float64 = warning_level / 10.0
}

// Value of IcbmTlv.message_data in an IcbmChannel.plain_text message: a
// list of fragments.
const FragmentId uint8 {
  text = 0x01          "the text: MessageText",
  capabilities = 0x05  "capabilities the sender supports",
}

packet IcbmFragment be {
  id uint8 : FragmentId,
  version uint8,
  length uint16 = sizeof(data),
  data switch id {
    FragmentId.text => text MessageText,
    _ => other bytes[]       // FragmentId.capabilities, ...
  } size length
}

packet IcbmMessage be {
  fragments IcbmFragment[]
}

// Data of fragment FragmentId.text.
const Charset uint16 {
  ascii = 0x0000       "US-ASCII",
  ucs2be = 0x0002      "UCS-2, big-endian",
  iso_8859_1 = 0x0003  "ISO-8859-1",
}

packet MessageText be {
  charset uint16 : Charset,
  charsubset uint16,
  text bytes[]
}
